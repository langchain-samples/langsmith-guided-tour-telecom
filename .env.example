# LangSmith — tracing + Context Hub + model gateway (ONE token does all three)
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Model calls route through the LangSmith LLM Gateway using LANGSMITH_API_KEY,
# so no separate model-provider key is required.
