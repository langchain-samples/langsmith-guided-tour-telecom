# LangSmith — tracing + Context Hub
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Model provider key (default: Anthropic, vision-capable Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: route model calls through your own gateway/proxy endpoint.
# Leave unset to call Anthropic directly with ANTHROPIC_API_KEY.
# MODEL_BASE_URL=https://your-gateway.example/anthropic
# MODEL_NAME=claude-sonnet-4-6
